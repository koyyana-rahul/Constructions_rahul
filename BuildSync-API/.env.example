# ─────────────────────────────────────────────────────────────────────────────
# Builtra API - environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Port the API listens on. The frontend's .env.local must point at the same
# port: VITE_API_URL=http://localhost:<PORT>/api
PORT=5050

# ── Database ────────────────────────────────────────────────────────────────
# Your MongoDB connection string.
#
# For MongoDB Atlas, the string looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/builtra
#
# IMPORTANT: Atlas only accepts connections from IP addresses on the
# cluster's "Network Access" list. If you cannot connect, add your IP in the
# Atlas dashboard, or run the temporary local database instead:
#
#     npm run dev:local
#
# IMPORTANT - EXISTING INSTALLATIONS: the database name at the end of the URL
# is the DATABASE, not the brand. Changing it points the application at a
# different, empty database and your users, attendance and payroll records
# will appear to have vanished. The rebrand from BuildSync to Builtra did NOT
# rename any database. If you are upgrading an existing install, leave the
# database name exactly as it is. The name below is only correct for a NEW
# installation, where the database is created on first write.
#
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/builtra

# How long to wait for a database connection before failing (milliseconds).
MONGO_TIMEOUT_MS=10000

# ── Authentication ──────────────────────────────────────────────────────────
# SECRET KEY USED TO SIGN SESSION TOKENS.
#
# Generate a real one - do not leave the placeholder:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Anyone who knows this value can forge an administrator token.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# How long a signed-in browser session lasts. Accepts values such as 2h, 1d
# or 3600s. Defaults to 1d when omitted.
JWT_EXPIRES=2h

# bcrypt work factor for new password hashes. 12 is a sensible production
# value; the application accepts 10-15 and defaults to 10 when omitted.
BCRYPT_SALT_ROUNDS=12

# ── Email delivery ──────────────────────────────────────────────────────────
# Account invitations are emailed. Without a provider the account is still
# created, but the invitation is reported as NOT delivered and the
# administrator shares the setup link manually. The application never claims
# an email was sent when it was not.
#
#   EMAIL_PROVIDER=http     a JSON REST send API (no npm dependency needed).
#                           EMAIL_API_URL defaults to the Resend endpoint.
#   EMAIL_PROVIDER=smtp     classic SMTP. Needs `npm install nodemailer`.
#   EMAIL_PROVIDER=capture  development only - writes the message to
#                           .email-outbox/ instead of sending it.
#
# Verify your setup with:
#     npm run email:check -- you@yourdomain.com
#
EMAIL_PROVIDER=capture
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM=Builtra <no-reply@yourdomain.com>

# SMTP provider (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ── Invitations ─────────────────────────────────────────────────────────────
# The public frontend origin used to build password-setup links.
#
# SECURITY: this must be a TRUSTED, CONFIGURED value. The application never
# builds a setup link from the incoming request's Host header, because an
# attacker could forge it and make the application email a victim a link
# pointing at a server the attacker controls.
FRONTEND_BASE_URL=http://localhost:5173

# How long a password-setup link stays valid, in hours.
INVITATION_TTL_HOURS=48

# Comma-separated list of frontend origins allowed to call the API with
# credentials. Required in production. Example:
#   CLIENT_ORIGIN=https://app.yourdomain.com
CLIENT_ORIGIN=http://localhost:5173

# ── Cloudinary (file uploads) ──────────────────────────────────────────────
# Cloudinary is used for storing project documents, receipts, profile photos,
# and daily-report photos. Set CLOUDINARY_URL as a single connection string
# OR provide the individual variables.
#
#   CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
#   # OR (individual variables):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
#
# The application falls back to local disk storage when CLOUDINARY_URL is not
# set, so development can proceed without a Cloudinary account.
CLOUDINARY_URL=

# ── First administrator (used by `npm run seed`) ────────────────────────────
# Required ONCE, when creating the first administrator. `npm run seed` is
# idempotent: if the email already exists it makes no changes and succeeds.
#
# Set a strong, unique password yourself. The seed refuses to create an
# administrator with a weak password, and there is deliberately no default.
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
