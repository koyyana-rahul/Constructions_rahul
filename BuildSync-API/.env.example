# ─────────────────────────────────────────────────────────────────────────────
# Builtra API - environment template
#
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env      (Windows: copy .env.example .env)
#
# `.env` is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# Port the API listens on. The frontend's .env.local must point at the same
# port: VITE_API_URL=http://localhost:<PORT>/api
PORT=5050

# ── Database ────────────────────────────────────────────────────────────────
# Your MongoDB connection string.
#
# For MongoDB Atlas, the string looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/builtra
#
# IMPORTANT: Atlas only accepts connections from IP addresses on the
# cluster's "Network Access" list. If you cannot connect, add your IP in the
# Atlas dashboard, or run the temporary local database instead:
#
#     npm run dev:local
#
# IMPORTANT - EXISTING INSTALLATIONS: the database name at the end of the URL
# is the DATABASE, not the brand. Changing it points the application at a
# different, empty database and your users, attendance and payroll records
# will appear to have vanished. The rebrand from BuildSync to Builtra did NOT
# rename any database. If you are upgrading an existing install, leave the
# database name exactly as it is. The name below is only correct for a NEW
# installation, where the database is created on first write.
#
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/builtra

# How long to wait for a database connection before failing (milliseconds).
MONGO_TIMEOUT_MS=10000

# ── Authentication ──────────────────────────────────────────────────────────
# SECRET KEY USED TO SIGN SESSION TOKENS.
#
# Generate a real one - do not leave the placeholder:
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
# Anyone who knows this value can forge an administrator token.
JWT_SECRET=CHANGE_ME_generate_a_long_random_string

# ── First administrator (used by `npm run seed`) ────────────────────────────
# The account created by `npm run seed`. Change the password before using it
# anywhere real, and change it again after the first sign-in.
ADMIN_NAME=BUILTRA
ADMIN_EMAIL=admin@builtra.com
ADMIN_PASSWORD=#Rahul8620
