{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "test": "node --env-file-if-exists=.env --env-file=.env.test --test tests/*.test.js",
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "nodemon --env-file-if-exists=.env index.js",
    "test:watch": "node --env-file-if-exists=.env --env-file=.env.test --test --watch tests/*.test.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env userSeed.js",
    "dev:local": "node --env-file-if-exists=.env scripts/dev-local.mjs",
    "email:check": "node --env-file-if-exists=.env scripts/email-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.0",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.2",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.1.4",
    "path": "^0.12.7"
  },
  "main": "index.js",
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
