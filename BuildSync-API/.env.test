# Test-only environment.
#
# Safe to commit: it contains NO production secrets and NO production data.
# The JWT secret here signs tokens for the isolated `_test` database only.
#
# Loaded AFTER `.env`, so these values win for test runs:
#   node --env-file-if-exists=.env --env-file=.env.test --test tests/*.test.js
#
# Set `USE_IN_MEMORY_DB=true` to force the in-process MongoDB (no external
# server needed). Leave it unset to prefer the real MongoDB from `.env` and
# fall back to the in-memory server automatically if it is unreachable.

NODE_ENV=test
JWT_SECRET=builtra-test-only-secret-never-used-in-production

# Tests must never contact a real mail provider, even when the developer's
# local `.env` has Resend/SMTP credentials configured.
EMAIL_PROVIDER=capture
EMAIL_API_KEY=
EMAIL_FROM=Builtra <test@example.invalid>
FRONTEND_BASE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Keep the test suite fast and deterministic.
JWT_EXPIRES=1d
BCRYPT_SALT_ROUNDS=10
